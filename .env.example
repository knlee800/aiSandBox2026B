# =============================================================================
# Launch State (required in production)
# =============================================================================
# Controls platform access level at startup.
# Valid values: CLOSED, INTERNAL, EARLY_ACCESS, PUBLIC
# NOTE: LIMITED_AVAILABILITY is NOT a valid value.
# In production, LAUNCH_STATE must be set explicitly or startup will fail.
LAUNCH_STATE=INTERNAL

# =============================================================================
# AI Provider Configuration
# =============================================================================
# Determines which AI provider ai-service uses for execution.
# Valid production values: openai, anthropic, groq, xai, deepseek
# stub is for local development only and is not allowed in production.
# For local dev, override to: AI_PROVIDER=stub
AI_PROVIDER=anthropic

# Provider API keys
# IMPORTANT: In production/staging, the startup validator currently requires
# BOTH ANTHROPIC_API_KEY and OPENAI_API_KEY to be non-empty, even if only
# one provider is selected via AI_PROVIDER. This is a known configuration
# requirement in configuration.validator.ts.
#
# DEPRECATED: CLAUDE_API_KEY is no longer used. Use ANTHROPIC_API_KEY instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# =============================================================================
# Database Configuration
# =============================================================================
# For local development (Node services outside Docker):
#   - POSTGRES_HOST will auto-override to 'localhost' if set to 'postgres'
#   - This is handled by services/api-gateway/src/config/database.config.ts
# For production (services inside Docker):
#   - Use POSTGRES_HOST=postgres (docker-compose network hostname)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aisandbox
POSTGRES_PASSWORD=aisandbox_dev_password_change_in_production
POSTGRES_DB=aisandbox
DATABASE_URL=postgresql://aisandbox:aisandbox_dev_password_change_in_production@postgres:5432/aisandbox

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis:6379

# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=development
PORT=3000
API_PORT=4000
APP_BASE_URL=http://localhost:3000

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_SECRET=change_this_in_production_use_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Internal Service Authentication
# =============================================================================
# Shared secret for service-to-service communication.
# Used by ai-service and container-manager to call api-gateway /api/internal/* endpoints.
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_KEY=change_this_in_production_use_a_long_random_hex_string

# =============================================================================
# Session Configuration
# =============================================================================
SESSION_TIMEOUT_MINUTES=120
MAX_CONCURRENT_SESSIONS=8

# =============================================================================
# Container Configuration
# =============================================================================
DOCKER_HOST=unix:///var/run/docker.sock
CONTAINER_CPU_LIMIT=0.5
CONTAINER_MEMORY_LIMIT=1g
CONTAINER_DISK_LIMIT=3g

# =============================================================================
# Billing & Payment Configuration
# =============================================================================
# CRITICAL: Financial Kill-Switch (Task 12B2)
# Explicit hard safety lock for all payment operations.
# DEFAULT MUST BE: false
#
# When false (default):
# - NO payment execution possible
# - NO Stripe charges
# - ChargeReadinessService gate blocks all charging paths
# - System is in safe mode
#
# When true:
# - Charging CAN be enabled (but requires additional implementation)
# - ChargeReadinessService gate allows charging IF all other conditions pass
# - ONLY set to true in production after:
#   1. Stripe production keys configured
#   2. Webhook endpoints verified
#   3. Reconciliation validated
#   4. Legal/compliance approval obtained
#   5. Monitoring and alerting in place
#
# WARNING: Setting this to true does NOT automatically enable charging.
# It only removes the system-level block. Actual charging requires
# additional implementation beyond Phase 12B2.
#
# NEVER set to true in development unless explicitly testing charging flow.
BILLING_CHARGES_ENABLED=false

# =============================================================================
# Agent Harness Configuration
# =============================================================================
# Controls ai-service Agent Harness tool loop.
# Default: false (tool loop disabled).
# Valid values: true, false (case-insensitive, trimmed).
# Invalid values cause ai-service startup failure.
# Do not set true until later approved Agent Harness activation tasks are complete.
AGENT_HARNESS_ENABLE_TOOL_LOOP=false
