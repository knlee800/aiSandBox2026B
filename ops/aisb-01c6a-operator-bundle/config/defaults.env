# EXEC-01C6A operator defaults. No secrets. Matches accepted script ranges.
AISB_01C6A_WAIT_MS=20000
AISB_01C6A_OP_TIMEOUT_MS=8000
AISB_01C6A_SHUTDOWN_TIMEOUT_MS=5000
# Overlay windows: worker <=1800s, gateway <=300s. Not 86400.
# AISB_01C6A_WORKER_WINDOW_SEC=1800
# AISB_01C6A_GATEWAY_WINDOW_SEC=300
# AISB_01C6A_RESTORE_RESERVE_SEC=20
AISB_01C6A_WORKER_LOG_PATH=/home/ubuntu/.pm2/logs/aisandbox-ai-service-out.log
NODE_PATH=/opt/aisandbox/node_modules:/opt/aisandbox/services/ai-service/node_modules
NODE_BIN=/usr/bin/node
TCPDUMP_BIN=/usr/bin/tcpdump
GATEWAY_APP=aisandbox-api-gateway
WORKER_APP=aisandbox-ai-service
BASELINE_FAILED_JOBS=1,2,3
