[Unit]
Description=aiSandBox gateway migrations (oneshot; no install section)
After=network-online.target postgresql@15-main.service
Wants=postgresql@15-main.service

[Service]
Type=oneshot
User=aisandbox
Group=aisandbox
WorkingDirectory=/opt/aisandbox/services/api-gateway
Environment=HOME=/var/lib/aisandbox
EnvironmentFile=/etc/aisandbox/gateway.env
ExecStart=/usr/bin/node /opt/aisandbox/node_modules/typeorm/cli.js migration:run -d dist/data-source.js
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
SyslogIdentifier=aisandbox-migrate
