[Unit]
Description=aiSandBox AI service (:4001)
Wants=network-online.target postgresql@15-main.service redis-server.service
After=network-online.target postgresql@15-main.service redis-server.service
PartOf=aisandbox.target
AssertPathExists=!/var/lib/aisandbox-ops/maintenance
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=aisandbox
Group=aisandbox
WorkingDirectory=/opt/aisandbox/services/ai-service
EnvironmentFile=/etc/aisandbox/ai.env
ExecStart=/usr/bin/node /opt/aisandbox/services/ai-service/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
SyslogIdentifier=aisandbox-ai

[Install]
WantedBy=aisandbox.target
