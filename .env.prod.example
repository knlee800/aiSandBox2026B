# Production Environment Template
# Copy to .env and fill in real values. Do NOT commit .env.

# --- Shared ---
NODE_ENV=production
LOG_LEVEL=info

# --- Database ---
POSTGRES_USER=aisandbox
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=aisandbox
DATABASE_URL=postgresql://aisandbox:CHANGE_ME_STRONG_PASSWORD@postgres:5432/aisandbox

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# --- API Gateway ---
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
JWT_EXPIRES_IN=15m
INTERNAL_SERVICE_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
AI_PROVIDER=anthropic
LAUNCH_STATE=INTERNAL
BILLING_CHARGES_ENABLED=false
# QuotaGuard default tokens/day for API keys not in API_KEY_QUOTAS (TASK-56A)
DEFAULT_TOKENS_PER_DAY=100000

# --- AI Provider Keys (required when AI_PROVIDER is not stub) ---
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
# OPENAI_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=

# --- Container Manager ---
# DOCKER_HOST set automatically via volume mount
# CONTAINER_CPU_LIMIT=0.5
# CONTAINER_MEMORY_LIMIT=1g

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
