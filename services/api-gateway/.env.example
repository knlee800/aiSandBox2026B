# Environment Configuration Example (Local Development)
# Copy this file to .env and adjust values as needed

# Required: Environment (development, staging, production)
NODE_ENV=development

# Required: Server port
PORT=4000

# Required in production: auth/session/OAuth secrets
JWT_SECRET=change_this_in_production_use_a_long_random_string
SESSION_SECRET=change_this_in_production_use_a_different_long_random_string
OAUTH_STATE_SECRET=change_this_in_production_use_a_separate_long_random_string

# Optional: Google OAuth (required when Google sign-in is enabled)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Optional: Apple OAuth (required when Apple sign-in is enabled)
# APPLE_CLIENT_ID is the Apple Services ID (not the Bundle ID).
# APPLE_PRIVATE_KEY should contain .p8 PEM content with newlines serialized as \n.
# Never commit a real APPLE_PRIVATE_KEY value.
APPLE_CLIENT_ID=your_apple_services_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----
APPLE_CALLBACK_URL=http://localhost:4000/api/auth/apple/callback

# Required: Database connection
# Option 1: Use DATABASE_URL (recommended for Docker/production)
# DATABASE_URL=postgresql://aisandbox:password@localhost:5432/aisandbox

# Option 2: Use individual variables (local development)
# If DATABASE_URL is not set, these will be used:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aisandbox
POSTGRES_PASSWORD=aisandbox_dev_password_change_in_production
POSTGRES_DB=aisandbox

# Optional: Provider API keys (required in staging/production)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Phase 28: AI Provider Selection (api-gateway owns provider selection)
# Determines which AI provider ai-service should use for execution
# Options: stub (default), anthropic, openai, groq, xai, deepseek
AI_PROVIDER=stub

# Optional: Redis (not required for MVP)
# REDIS_URL=redis://localhost:6379

# Optional: Launch state (defaults to LIMITED_AVAILABILITY)
# LAUNCH_STATE=LIMITED_AVAILABILITY

# Optional: Abort mode (defaults to NONE)
# ABORT_MODE=NONE
